	partition pbi_customer360 = m
		mode: import
		source =
				let
				    Source = Sql.Database("<YOUR-LAKEHOUSE-SQL-ENDPOINT>", "LH_C360_Lab"),
				    Data = Source{[Schema="dbo",Item="pbi_customer360"]}[Data]
				in
				    Data
