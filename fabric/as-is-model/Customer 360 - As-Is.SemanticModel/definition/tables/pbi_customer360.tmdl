table pbi_customer360
	lineageTag: pbi_customer360

	column 'Tenure Days' = DATEDIFF ( pbi_customer360[SignupDateTime], TODAY (), DAY )
		dataType: int64
		formatString: 0
		summarizeBy: sum

	column Email
